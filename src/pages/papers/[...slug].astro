---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Cells from "../../components/Cells.astro";
import Tags from "../../components/Tags.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const papers = await getCollection("papers", (p) => !p.data.url);
  return papers.map((paper) => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const { data } = paper;
---

<Base title={data.title} description={data.abstract}>
  <PageHeader
    eyebrow={`paper / ${data.date.getFullYear()}`}
    title={data.title}
  />

  <div class="stack">
    <div class="panel">
      <div class="panel-body">
        <Tags tags={data.tags} />
      </div>
      <Cells
        items={[
          ["date", data.date.toISOString().slice(0, 10)],
          ["published in", data.published_in],
          ["co-authors", data.coauthors.join(", ")],
        ]}
      />
      <Cells
        links={[
          { label: "pdf", href: data.pdf_url, external: true },
          { label: "source", href: data.repo, external: true },
        ]}
      />
    </div>

    <article class="panel panel-body">
      <Content />
    </article>
  </div>
</Base>
