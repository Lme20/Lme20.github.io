---
import Base from "../../layouts/Base.astro";
import Media from "../../components/Media.astro";
import { getCollection } from "astro:content";

const designs = (await getCollection("design")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, { src: string; alt: string; href: string }[]>();
for (const entry of designs) {
  const year = entry.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  for (const img of entry.data.gallery) {
    byYear.get(year)!.push({ ...img, href: `/design/${entry.id}` });
  }
}
---

<Base title="Design" description="Posters, UI designs and visual work">
  <h1>~/design</h1>

  {
    [...byYear.entries()].map(([year, images]) => (
      <section>
        <div class="separator">
          <span class="label">~{year}</span>
          <span class="line">{"❯".repeat(100)}</span>
        </div>
        <div class="masonry">
          {images.map((img, i) => (
            <a href={img.href} class="masonry-item media-host">
              <Media src={img.src} alt={img.alt} />
              <span class="masonry-index">
                [{String(i + 1).padStart(3, "0")}]
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  {designs.length === 0 && <p>Nothing here yet.</p>}
</Base>

<style>
  .masonry {
    columns: 5 180px;
    column-gap: 1rem;
    margin-top: 1rem;
  }

  .masonry-item {
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    border: 1px solid #333;
  }

  .masonry-item:hover,
  .masonry-item:focus-visible {
    border-color: var(--accent);
    text-decoration: none;
  }

  .masonry-media {
    position: relative;
    display: block;
  }

  .masonry-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .masonry-index {
    display: block;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    color: #666;
    text-align: right;
  }

  .masonry-item:hover .masonry-index,
  .masonry-item:focus-visible .masonry-index {
    color: var(--accent);
  }

  @media (hover: hover) {
    .masonry-media img {
      filter: grayscale(1) contrast(1.3) brightness(0.9);
      transition: filter 0.2s;
    }

    /* Green tint */
    .masonry-media::before {
      content: "";
      position: absolute;
      inset: 0;
      background: var(--accent);
      mix-blend-mode: multiply;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    /* Halftone dots */
    .masonry-media::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(var(--bg) 0.8px, transparent 0.2px);
      background-size: 3px 3px;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    .masonry-item:hover img,
    .masonry-item:focus-visible img {
      filter: none;
    }

    .masonry-item:hover .masonry-media::before,
    .masonry-item:hover .masonry-media::after,
    .masonry-item:focus-visible .masonry-media::before,
    .masonry-item:focus-visible .masonry-media::after {
      opacity: 0;
    }
  }
</style>
