---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Media from "../../components/Media.astro";
import { getCollection } from "astro:content";

const designs = (await getCollection("design")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, { src: string; alt: string; href: string }[]>();
for (const entry of designs) {
  const year = entry.data.date.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  for (const img of entry.data.gallery) {
    byYear.get(year)!.push({ ...img, href: `/design/${entry.id}` });
  }
}

const total = [...byYear.values()].reduce((sum, images) => sum + images.length, 0);
---

<Base title="Design" description="Posters, UI designs and visual work">
  <PageHeader
    eyebrow={`design / ${total} pieces`}
    title="Posters, UI & visuals."
  />

  {
    [...byYear.entries()].map(([year, images]) => (
      <section>
        <h2 class="year-rule">{year}</h2>
        <div class="masonry">
          {images.map((img, i) => (
            <a href={img.href} class="masonry-item panel media-host">
              <Media src={img.src} alt={img.alt} />
              <span class="masonry-index">
                {String(i + 1).padStart(3, "0")}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }

  {designs.length === 0 && <p>Nothing here yet.</p>}
</Base>

<style>
  .masonry {
    columns: 5 180px;
    column-gap: 1rem;
  }

  .masonry-item {
    display: block;
    break-inside: avoid;
    margin-bottom: 1rem;
    transition: border-color 0.2s;
  }

  .masonry-item:hover,
  .masonry-item:focus-visible {
    border-color: var(--fg-bright);
    text-decoration: none;
  }

  /* Number strip under each image, inverted on hover like the link cells */
  .masonry-index {
    display: block;
    padding: 0.2rem 0.6rem;
    border-top: 1px solid var(--fg-dim);
    color: var(--fg-dim);
    font-size: 0.75em;
    text-align: right;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .masonry-item:hover .masonry-index,
  .masonry-item:focus-visible .masonry-index {
    background: var(--fg-bright);
    color: var(--bg);
  }
</style>
