---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Cells from "../../components/Cells.astro";
import Gallery from "../../components/Gallery.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("design");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"design">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, gallery, tools, kind } = entry.data;
---

<Base title={title} description={description}>
  <PageHeader eyebrow={`design / ${kind} / ${date.getFullYear()}`} title={title} />

  <div class="stack">
    <div class="panel">
      <p class="panel-body">{description}</p>
      <Cells
        items={[
          ["date", date.toISOString().slice(0, 10)],
          ["tools", tools.join(", ")],
        ]}
      />
    </div>

    <article class="panel panel-body">
      <Content />
    </article>

    <Gallery images={gallery} columns={2} />
  </div>
</Base>
