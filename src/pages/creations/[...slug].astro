---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Cells from "../../components/Cells.astro";
import Tags from "../../components/Tags.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const creations = await getCollection("creations");
  return creations.map((creation) => ({
    params: { slug: creation.id },
    props: { project: creation },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={data.title} description={data.description}>
  <PageHeader
    eyebrow={`creation / ${data.date.getFullYear()}`}
    title={data.title}
  />

  <div class="stack">
    <div class="panel">
      <div class="panel-body">
        <Tags tags={data.tags} />
      </div>
      <Cells items={[["date", data.date.toISOString().slice(0, 10)]]} />
      <Cells
        links={[
          { label: "live demo", href: data.url, external: true },
          { label: "source", href: data.repo, external: true },
        ]}
      />
    </div>

    <article class="panel panel-body">
      <Content />
    </article>
  </div>
</Base>
