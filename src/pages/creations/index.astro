---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Card from "../../components/Card.astro";
import { getCollection } from "astro:content";

const content = (await getCollection("creations")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const group = new Map<number, typeof content>();
for (const creation of content) {
  const year = creation.data.date.getFullYear();
  if (!group.has(year)) group.set(year, []);
  group.get(year)!.push(creation);
}
---

<Base title="Creations" description="Personal projects">
  <PageHeader
    eyebrow={`creations / ${content.length} entries`}
    title="Things I've created."
  />

  {
    [...group.entries()].map(([year, projects]) => (
      <section>
        <h2 class="year-rule">{year}</h2>
        <div class="card-grid">
          {projects.map(({ id, data }) => (
            <Card
              href={`/creations/${id}`}
              title={data.title}
              description={data.description}
              date={data.date}
              tags={data.tags}
              thumbnail={data.thumbnail}
              repo={data.repo}
              url={data.url}
            />
          ))}
        </div>
      </section>
    ))
  }

  {content.length === 0 && <p>No projects yet.</p>}
</Base>
