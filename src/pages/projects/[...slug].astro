---
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Cells from "../../components/Cells.astro";
import Tags from "../../components/Tags.astro";
import Gallery from "../../components/Gallery.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;
---

<Base title={data.title} description={data.description}>
  <PageHeader
    eyebrow={`project / ${data.date.getFullYear()}`}
    title={data.title}
  />

  <div class="stack">
    <div class="panel">
      <div class="panel-body">
        <Tags tags={data.tags} />
      </div>
      <Cells
        items={[
          ["date", data.date.toISOString().slice(0, 10)],
          ["role", data.role],
          ["duration", data.duration],
          ["team", data.team],
          ["platform", data.platform],
          ["contributions", data.contributions.join(" · ")],
        ]}
      />
      <Cells
        links={[
          { label: "live demo", href: data.url, external: true },
          { label: "source", href: data.repo, external: true },
        ]}
      />
    </div>

    <article class="panel panel-body">
      <Content />
    </article>

    {data.gallery.length > 0 && <Gallery images={data.gallery} columns={3} />}
  </div>
</Base>
