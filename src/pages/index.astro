---
import Base from "../layouts/Base.astro";
---

<Base title="Hello World" fullscreen={true}>
  <main id="hero">
    <!-- Top-left corner, as on the original home page -->
    <div id="home-contact">
      <a href="mailto:louisme.2014@gmail.com">louisme.2014@gmail.com</a>
      <a
        href="https://www.linkedin.com/in/louis-mercier-713657134/"
        target="_blank"
        rel="noopener">linkedin/louis-mercier</a
      >
      <a href="https://github.com/Lme20" target="_blank" rel="noopener"
        >github/Lme20</a
      >
      <span>Gothenburg, Sweden</span>
    </div>

    <div id="welcome">
      <p class="welcome-title">Welcome to my space</p>
      <!-- The readable text is in .sr-only; the .scramble copies are the
           animated, decorative version and are hidden from screen readers. -->
      <h1 id="welcome-name">
        <span class="sr-only">Louis Mercier</span>
        <span class="scramble" aria-hidden="true">LOUIS</span>
        <span class="scramble" aria-hidden="true">MERCIER</span>
      </h1>
      <p class="welcome-sub">
        <span class="sr-only">Software & Tools Developer</span>
        <span class="scramble" aria-hidden="true">Software & Tools Developer</span>
      </p>
      <p class="welcome-caption">I build things that should exist.</p>
    </div>

    <div id="bust">
      <canvas id="bust-canvas" aria-hidden="true"></canvas>
    </div>
  </main>

  <div class="marquee">
    <div class="marquee-track">
      <span class="marquee-note">
        - site under construction, more projects coming :)
      </span><span>▓</span>
      <span>C++</span><span>▓</span>
      <span>Python</span><span>▓</span>
      <span>C#</span><span>▓</span>
      <span>MongoDB</span><span>▓</span>
      <span>TypeScript</span><span>▓</span>
      <span>React</span><span>▓</span>
      <span>Vue.js</span><span>▓</span>
      <span>Unity 6</span><span>▓</span>
      <span>Unreal Engine 5</span><span>▓</span>
      <span>Electron</span><span>▓</span>
      <span>Docker</span><span>▓</span>
      <span>Git</span><span>▓</span>
      <span>Figma</span><span>▓</span>
      <span>SQLite</span><span>▓</span>
      <span>SDL2</span><span>▓</span>
      <span>BGFX</span><span>▓</span>
      <!-- second round-->
      <span class="marquee-note"
        >- site under construction, more projects coming :)</span
      ><span>▓</span>
      <span>C++</span><span>▓</span>
      <span>Python</span><span>▓</span>
      <span>C#</span><span>▓</span>
      <span>MongoDB</span><span>▓</span>
      <span>TypeScript</span><span>▓</span>
      <span>React</span><span>▓</span>
      <span>Vue.js</span><span>▓</span>
      <span>Unity 6</span><span>▓</span>
      <span>Unreal Engine 5</span><span>▓</span>
      <span>Electron</span><span>▓</span>
      <span>Docker</span><span>▓</span>
      <span>Git</span><span>▓</span>
      <span>Figma</span><span>▓</span>
      <span>SQLite</span><span>▓</span>
      <span>SDL2</span><span>▓</span>
      <span>BGFX</span><span>▓</span>
    </div>
  </div>

  <script>
    import "../scripts/home-3d"; // the bust

    // ── Interactive text ──
    // Every character of a .scramble element becomes its own element.
    // Characters near the pointer briefly turn into random glyphs, then settle
    // back. On load each line "decodes" from left to right.
    const SCRAMBLE = "ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%&$@";
    const REACH = 2; // neighbours scrambled on each side of the pointer

    type Cell = { el: HTMLSpanElement; char: string; until: number };

    const active = new Set<Cell>();
    let running = false;

    function tick(now: number) {
      for (const cell of active) {
        if (now >= cell.until) {
          cell.el.textContent = cell.char;
          active.delete(cell);
        } else {
          cell.el.textContent =
            SCRAMBLE[Math.floor(Math.random() * SCRAMBLE.length)];
        }
      }
      if (active.size) {
        setTimeout(() => requestAnimationFrame(tick), 40); // ~20 changes/sec
      } else {
        running = false;
      }
    }

    function scramble(cell: Cell, ms: number) {
      if (cell.char === " ") return; // keep the letter shapes intact
      cell.until = performance.now() + ms;
      active.add(cell);
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    }

    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    document.querySelectorAll<HTMLElement>(".scramble").forEach((host) => {
      const cells: Cell[] = [...host.textContent!.trim()].map((char) => {
        const el = document.createElement("span");
        el.textContent = char;
        return { el, char, until: 0 };
      });
      host.replaceChildren(...cells.map((cell) => cell.el));

      host.addEventListener("pointermove", (e) => {
        const i = cells.findIndex((cell) => cell.el === e.target);
        if (i < 0) return;
        for (let j = i - REACH; j <= i + REACH; j++) {
          if (cells[j]) scramble(cells[j], 250);
        }
      });

      // Decode-in on load, unless the visitor asked their system for less motion
      if (!calm) cells.forEach((cell, i) => scramble(cell, 250 + i * 45));
    });
  </script>
</Base>

<style>
  /* ── Hero: text left, bust right ──────────────────────── */
  /* No z-index here on purpose: it would wall the hero off from the waves and
     stop the name and bust canvases from blending with them. */
  #hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr; /* contact block, then the name */
    gap: 1rem 2rem;
    padding: 1rem 1.5rem 4rem;
    min-height: calc(100dvh - 3.5rem); /* viewport minus the header */
  }

  #welcome {
    align-self: center;
  }

  /* The bust canvas is black where it is empty. "lighten" keeps whichever is
     brighter, canvas or waves, so the black disappears and the waves show
     through instead of a dark rectangle. */
  #bust-canvas {
    mix-blend-mode: lighten;
  }

  /* Present for screen readers, invisible on screen */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  #welcome-name {
    font-family: var(--font-display);
    font-size: clamp(4rem, 11vw, 12rem);
    font-weight: 400; /* thin pixel strokes */
    line-height: 0.75;
    margin: 0.5rem 0 1rem;
    width: max-content;
    max-width: 100%;
    cursor: crosshair;

    /* Pink → purple → cyan gradient clipped to the characters */
    color: #ff3d9a; /* fallback if background-clip is unsupported */
    background: linear-gradient(90deg, #ff3d9a, #b03ad8, #3ad8ff);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* One word per line */
  #welcome-name .scramble {
    display: block;
  }

  .welcome-title {
    font-family: var(--font-display);
    font-size: 1.3em;
    color: var(--fg-bright);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .welcome-sub {
    font-family: var(--font-display);
    font-size: 1.6em;
    color: var(--fg-bright);
    cursor: crosshair;
  }

  .welcome-caption {
    font-family: var(--font-display);
    font-size: 1.1em;
    color: #a6a6a6;
    margin-top: 0.5rem;
    font-style: italic;
  }

  /* ── Contact ──────────────────────────────────────────── */
  #home-contact {
    justify-self: start;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-family: var(--font-display);
    font-size: 1em;
    background: var(--bg);
    padding: 0.5rem 0.75rem;
  }

  #home-contact a {
    color: var(--fg);
    text-decoration: none;
  }

  #home-contact a:hover {
    color: var(--fg-bright);
    text-decoration: underline;
  }

  #home-contact span {
    color: var(--fg-dim);
  }

  /* ── Bust box ─────────────────────────────────────────── */
  #bust {
    grid-column: 2;
    grid-row: 1 / span 2; /* beside both the contact block and the name */
    align-self: center;
    position: relative;
    height: min(70dvh, 46rem);
    cursor: grab;
    touch-action: none; /* let a finger drag rotate instead of scroll */
  }

  #bust:active {
    cursor: grabbing;
  }

  #bust-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Scrolling effect ─────────────────────────────────── */
  .marquee {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    overflow: hidden;
    padding: 0.3rem 0;
    font-family: var(--font-display);
    font-size: 0.8em; /* 16px: smaller than body text, like the original marquee */
    color: var(--fg-dim);
    background: var(--bg);
  }

  .marquee-note {
    color: var(--fg-bright);
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    white-space: nowrap;
    width: max-content;
    animation: scroll-left 30s linear infinite;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    #hero {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.5rem 1rem 2rem;
    }

    #bust {
      grid-column: 1;
      grid-row: auto;
      height: 50dvh;
    }

    .marquee {
      display: none;
    }
  }
</style>
