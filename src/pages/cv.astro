---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Cells from "../components/Cells.astro";
---

<Base title="CV" description="My resume">
  <PageHeader eyebrow="cv / louis mercier" title="Curriculum vitae.">
    <a class="button" href="/cv.pdf">download pdf ↓</a>
  </PageHeader>

  <div class="stack">
    <section class="panel">
      <h2 class="panel-title">Education</h2>

      <div class="row">
        <div class="row-head">
          <div>
            <h3>University of Gothenburg</h3>
            <p>M.Sc. Game Design & Technology</p>
          </div>
          <span class="row-date">Aug. 2024 – Jun. 2026</span>
        </div>
      </div>

      <div class="row">
        <div class="row-head">
          <div>
            <h3>University of Gothenburg</h3>
            <p>B.Sc. Software Engineering & Management</p>
          </div>
          <span class="row-date">Aug. 2020 – Jun. 2024</span>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2 class="panel-title">Experience</h2>

      <div class="row">
        <div class="row-head">
          <div>
            <h3>
              <a href="https://skipgu.org" target="_blank" rel="noopener"
                >SKIP - Student Association</a
              >
            </h3>
            <h4>Board Member</h4>
          </div>
          <span class="row-date">May 2023 – May 2025</span>
        </div>
        <p>
          Served on the board of SKIP, creating promotional content, posters
          and organizing extracurricular activities for computer science and
          software engineering students.
        </p>
      </div>

      <div class="row">
        <div class="row-head">
          <div>
            <h3>
              <a href="https://www.ctk.se" target="_blank" rel="noopener"
                >Chalmers Teknologkonsulter AB (CTK)</a
              >
            </h3>
            <h4>IT Consultant – Software Development</h4>
          </div>
          <span class="row-date">Oct. 2022 – Feb. 2024</span>
        </div>

        <div class="sub-entry">
          <h5>Regionala Cancercentrum – Melanoma Prognosis App</h5>
          <p>
            Collaborated in a team of three to implement and deploy a melanoma
            prognosis application. Developed and integrated UI components
            according to design specifications.
          </p>
          <p class="stack-line">React Native, Vercel, JavaScript</p>
        </div>

        <div class="sub-entry">
          <h5>AB Fastex Fästteknik – FastEx App</h5>
          <p>
            Improved functionality in their existing application, focusing on
            resolving issues in the item database.
          </p>
          <p class="stack-line">JavaScript, React, Docker</p>
        </div>

        <div class="sub-entry">
          <h5>Chalmers Studentkår – Website Redesign</h5>
          <p>
            Implemented the redesign of the website's frontend and ensured full
            compatibility with the existing Django backend.
          </p>
          <p class="stack-line">TypeScript, AngularJS, HTML5, SCSS, REST API</p>
        </div>
      </div>

      <div class="row">
        <div class="row-head">
          <div>
            <h3>University of Gothenburg</h3>
            <h4>Teaching Assistant</h4>
          </div>
          <span class="row-date">Oct. 2022 – Jun. 2023</span>
        </div>

        <div class="sub-entry">
          <h5>DIT348 – Software Development Methodologies</h5>
          <p>
            Assisted students with understanding stakeholder-product-process
            relationships, Agile-related tools, team-based development, and the
            use of KPIs.
          </p>
          <p class="stack-line">Agile Methodologies, KPI</p>
        </div>

        <div class="sub-entry">
          <h5>DAT257 – Agile Software Project Management</h5>
          <p>
            Supported teaching and student projects on software process
            fundamentals, agile/traditional practices, and software process
            improvement techniques. Guided individual groups on implementing
            Agile practices effectively.
          </p>
          <p class="stack-line">JavaScript, React, Docker</p>
        </div>
      </div>
    </section>

    <section class="panel">
      <h2 class="panel-title">Projects</h2>

      <div class="row">
        <h3>
          <a href="https://github.com/scape-engine/ScapeEngine"
            >Custom Game Engine</a
          >
        </h3>
        <p>
          Developed a 3D game engine that leverages procedural content
          generation (PCG) for rapid prototyping. Project made with BGFX, SDL2,
          ImGui, LibNoise2, FastNoise2.
        </p>
        <p class="stack-line">C++, BGFX, SDL2, ImGui, LibNoise2, FastNoise2</p>
      </div>

      <div class="row">
        <h3>
          <a href="https://github.com/Lme20/openscenario-osint-generator"
            >LLM AD/ADAS Test Scenario Generation</a
          >
        </h3>
        <p>
          Built a prototype for my Bachelor's thesis project using Python, web
          scraping and LLMs (Ollama & ChatGPT) to generate realistic test
          scenarios for autonomous driving systems AD/ADAS using the ASAM
          OpenSCENARIO standard.
        </p>
        <p class="stack-line">Python, Web Scraping, LLMs, ASAM OpenSCENARIO</p>
      </div>

      <div class="row">
        <h3><a href="https://github.com/Lme20/gitro">Gitro Asset Manager</a></h3>
        <p>
          Git-based Electron + React.js desktop app (in progress) for organizing
          game project assets, with an in-app 3D asset preview.
        </p>
        <p class="stack-line">TypeScript, Electron, React.js, Git, Three.js</p>
      </div>
    </section>

    <section class="panel">
      <h2 class="panel-title">Skills</h2>
      <Cells
        items={[
          ["languages", "C++, C#, Python, JavaScript, TypeScript, SQL, Java"],
          ["frameworks", "Electron, React, Vue.js, React Native, AngularJS"],
          [
            "tools",
            "Git, Docker, SQLite, .NET 6, OpenSCENARIO, Xmake, GitHub Flow",
          ],
          [
            "software",
            "Unity, Unreal Engine 5, Figma, Adobe Photoshop, Adobe Illustrator",
          ],
        ]}
      />
    </section>

    <section class="panel">
      <h2 class="panel-title">Personal Interests & Languages</h2>
      <Cells
        items={[
          [
            "languages",
            "French (native), Spanish (native), English (fluent), Swedish (proficient)",
          ],
          [
            "interests",
            "Systems programming, game development, generative AI, procedural content generation, linguistics, simulation software",
          ],
        ]}
      />
    </section>
  </div>
</Base>

<style>
  /* The panel title already draws the top line, so only rows after the
     first need one */
  .row {
    padding: 1rem;
  }

  .row + .row {
    border-top: 1px solid var(--fg-dim);
  }

  .row > * + * {
    margin-top: 0.5rem;
  }

  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .row h3 {
    font-size: 1.15em;
    text-transform: uppercase;
  }

  .row h3 a {
    color: var(--fg-bright);
  }

  .row h4 {
    color: var(--fg);
    font-weight: 400;
  }

  .row-date {
    flex-shrink: 0;
    color: var(--fg-dim);
    font-size: 0.85em;
  }

  .sub-entry {
    margin-left: 0.5rem;
    padding-left: 1rem;
    border-left: 1px solid var(--fg-dim);
  }

  .sub-entry h5 {
    color: var(--fg-bright);
    font-size: 0.95em;
    font-weight: 400;
  }

  .sub-entry p {
    margin-top: 0.25rem;
  }

  /* The tech used, under each entry */
  .stack-line {
    color: var(--fg-dim);
    font-size: 0.85em;
  }

  @media (max-width: 768px) {
    .row-head {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
