---
import Nav from "../components/Nav.astro";
import "../styles/global.css";
// Self-hosted fonts (no render-blocking request to Google Fonts)
import "@fontsource/vt323/400.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/700.css";
import vt323 from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  fullscreen?: boolean; // true for home page
}

const { title, description = "", fullscreen = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={vt323} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <!-- ASCII waves behind every page; fainter behind reading pages -->
    <canvas id="bg-waves" aria-hidden="true" data-dim={fullscreen ? 0.22 : 0.1}
    ></canvas>
    <Nav />

    {
      fullscreen ? (
        <slot />
      ) : (
        <main class="content">
          <slot />
        </main>
      )
    }

    <script>
      import "../scripts/home-waves";
    </script>
  </body>
</html>
