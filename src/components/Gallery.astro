---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  columns?: number;
}

const { images, columns = 2 } = Astro.props;
// 72rem max width = 1152px, split across the columns
const sizes = `(max-width: 768px) 100vw, ${Math.round(1152 / columns)}px`;
---

<div class="gallery" style={`--cols: ${columns}`}>
  {
    images.map((img) => (
      <a href={img.src.src} target="_blank" class="gallery-item">
        <Image
          src={img.src}
          alt={img.alt}
          widths={[600, 1200]}
          sizes={sizes}
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: 1rem;
  }

  .gallery-item {
    display: block;
    border: 1px solid var(--fg-dim);
    overflow: hidden;
    transition: border-color 0.2s;
  }

  .gallery-item:hover {
    border-color: var(--fg-bright);
  }

  .gallery-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
