---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  video?: string;
  ratio?: string; // omit to keep the natural size
  sizes?: string; // how wide the image is shown, so the browser picks a fitting file
}

const {
  src,
  alt,
  video,
  ratio,
  sizes = "(max-width: 768px) 100vw, 400px",
} = Astro.props;

// Videos need a plain URL for their poster frame
const poster = video
  ? await getImage({ src, width: Math.min(800, src.width), format: "webp" })
  : undefined;
---

<span
  class:list={["media", { fixed: ratio }]}
  style={ratio ? `--ratio: ${ratio}` : undefined}
>
  {
    video ? (
      <video
        src={video}
        poster={poster?.src}
        muted
        loop
        playsinline
        preload="none"
        aria-label={alt}
      />
    ) : (
      <Image
        src={src}
        alt={alt}
        widths={[400, 800]}
        sizes={sizes}
        loading="lazy"
      />
    )
  }
</span>

<script>
  document.querySelectorAll<HTMLVideoElement>(".media video").forEach((v) => {
    const host = v.closest(".media-host") ?? v;
    host.addEventListener("mouseenter", () => v.play().catch(() => {}));
    host.addEventListener("mouseleave", () => {
      v.pause();
      v.currentTime = 0;
    });
  });
</script>

<style>
  .media {
    position: relative;
    display: block;
  }

  .media img,
  .media video {
    display: block;
    width: 100%;
    height: auto;
  }

  .media.fixed img,
  .media.fixed video {
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }

  @media (hover: hover) {
    .media img,
    .media video {
      filter: grayscale(1) contrast(1.1);
      transition: filter 0.2s;
    }

    .media::before,
    .media::after {
      content: "";
      position: absolute;
      inset: 0;
      pointer-events: none;
      transition: opacity 0.2s;
    }

    /* Halftone dots */
    .media::after {
      background-image: radial-gradient(var(--bg) 0.8px, transparent 0.2px);
      background-size: 3px 3px;
      opacity: 0.2;
    }

    :global(.media-host:hover) .media img,
    :global(.media-host:hover) .media video,
    :global(.media-host:focus-within) .media img,
    :global(.media-host:focus-within) .media video {
      filter: none;
    }

    :global(.media-host:hover) .media::before,
    :global(.media-host:hover) .media::after,
    :global(.media-host:focus-within) .media::before,
    :global(.media-host:focus-within) .media::after {
      opacity: 0;
    }
  }
</style>
